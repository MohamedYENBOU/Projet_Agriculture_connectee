volatile double encodeur1B=0;                                        // compteur tick encodeurB du moteur1 
volatile double encodeur2A=0;                                       // compteur tick encodeurA du moteur2
 volatile double encodeur2B=0;                                     // compteur tick encodeurB du moteur2
double output1,consigne1=250,output2,consigne2=250;
double error=0.1;        // l'erreur max  dans les distances


//Parametres  pour les fonctions d'interruption des encodeurs
 double distance1=0.0,distance2=0.0;
 volatile double tour_r1=0,tour_r2=0;                           // distances parcourus et nombres de tours de roues

 // Coordonnées du robot
 double xr=0;                                                  // abscisse
 double yr=0;                                                  // ordonnées
 double Or=0;

// Function prototypes


void moveForward_X(double distance,int direct) ;
void moveForward_Y(double distance,int direct) ;
void turnLeft(double angle);
void turnRight(double angle);
