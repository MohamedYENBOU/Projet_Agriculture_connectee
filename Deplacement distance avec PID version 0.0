void moveForward_X(double distance,int direct) {                                   // fonction marche avant suivant l'axe des abscisses avec le sens
 
                                                                                   // direct==1 dans les x positifs et direct==0 dans le sens des x negatifs
  digitalWrite(MOTOR_PIN_DIRECT1,LOW);
  digitalWrite(MOTOR_PIN_DIRECT2,HIGH);
  consigne1=distance;
  consigne2=distance;
  byte p1=0,p2=0;
  double old_distance=0;
  myPID1.SetOutputLimit(0, consigne1*3/2);
  myPID2.SetOutputLimit(0, consigne2*3/2);
  while((consigne1-distance1)>=error && (consigne2-distance2)>=error)    // on avance tant que les erreur sur les deux moteur sont < a error
  {
    p1=myPID1.Compute();
    p2=myPID2.Compute();
    if(distance1>distance2)            // s'il y'a une distance d'un des moteurs superieur a l'autre, on augmente la vitesse de l'autre
    {
      p2+=5;
    }
    else if(distance2>distance1)
    p1+=5;
  
    analogWrite(MOTOR_PIN_SPEED1,p1);
    analogWrite(MOTOR_PIN_SPEED2,p2);
    if(direct)                         // verifie si on avance dans le sens des x positif si direct=1 et 0 sinon
    xr+= distance1-old_distance;    // vers les x positif donc  on  incremente x
    else
    xr-= distance1 -old_distance;   // vers les x negatifs donc  on incremente x

    old_distance=distance1;
    Serial.print("x:");
    Serial.print(xr);
    Serial.print(", y: ");
    Serial.print(yr);
    Serial.print(", angle: ");
    Serial.println(Or);
  }
  stop();
  
  distance1=0;distance2=0; encodeur1A=0;encodeur2A=0;
}                                                         // le code est pratiquement le meme pour la fonction de deplacement sur l'axe des Y


void moveForward_Y(double distance,int direct)                                     // fonction marche avant suivant l'axe des ordonnées  avec le sens
{
                                                                                     // direct==1 dans les y positifs et direct==0 dans le sens des y negatifs
   digitalWrite(MOTOR_PIN_DIRECT1,LOW);
  digitalWrite(MOTOR_PIN_DIRECT2,HIGH);
  consigne1=distance;
  consigne2=distance;
  byte p1=0,p2=0;
 double old_distance=0;
  myPID1.SetOutputLimit(0, consigne1*3/2);
  myPID2.SetOutputLimit(0, consigne2*3/2);
  while((consigne1-distance1)>=error && (consigne2-distance2)>=error)
  {
    p1=myPID1.Compute();
    p2=myPID2.Compute();
    if(distance1>distance2)
    {
      p2+=5;
    }
    else if(distance2>distance1)
    p1+=5;
    analogWrite(MOTOR_PIN_SPEED1,p1);
    analogWrite(MOTOR_PIN_SPEED2,p2);
    
    if(direct)
    yr+=distance1-old_distance;
    else
    yr-=distance1-old_distance;
    old_distance=distance1;
    Serial.print("x:");
    Serial.print(xr);
    Serial.print(", y: ");
    Serial.print(yr);
    Serial.print(", angle: ");
    Serial.println(Or);
  }
  stop();
  
  distance1=0;distance2=0; encodeur1A=0;encodeur2A=0;

}



void turnRight(double angle) {                                 //fonction pour tourner a droite avec des angle entre [-180;180] degré
  
  digitalWrite(MOTOR_PIN_DIRECT1,LOW);          
  digitalWrite(MOTOR_PIN_DIRECT2,LOW);
  consigne1=angle/degre_per_cm;
  consigne2=angle/degre_per_cm;
  byte p1=0,p2=0;
  double old_distance=0;
  myPID1.SetOutputLimit(0, consigne1*3/2);                    
  myPID2.SetOutputLimit(0, consigne2*3/2);
  while((consigne1-distance1)>=error && (consigne2-distance2)>=error)
  {
    p1=myPID1.Compute();
    p2=myPID2.Compute();
    if(distance1>distance2)
    {
      p2+=5;
    }
    else if(distance2>distance1)
    p1+=5;
    analogWrite(MOTOR_PIN_SPEED1,p1);
    analogWrite(MOTOR_PIN_SPEED2,p2);
    //Or+=(distance1-old_distance)*degre_per_cm;
    Serial.print("x:");
    Serial.print(xr);
    Serial.print(", y: ");
    Serial.print(yr);
    Serial.print(", angle: ");
    Serial.println(Or);
    //old_distance=distance1;
    
    
  }
  Or+=(distance1-old_distance)*degre_per_cm;             // incremente a la fin l'angle  qu'on a tourné
  stop();
  delay(30);
  if(Or>180)
    { Or-=360;}
  distance1=0;distance2=0; encodeur1A=0;encodeur2A=0;
}

void turnLeft(double angle) {                                 // fonction pour tourner a gauche  avec des angle entre [-180;180] degré
  digitalWrite(MOTOR_PIN_DIRECT1,HIGH);
  digitalWrite(MOTOR_PIN_DIRECT2,HIGH);

  consigne1=angle/degre_per_cm;
  consigne2=angle/degre_per_cm;
  byte p1=0,p2=0;
  double old_distance=0;
  myPID1.SetOutputLimit(0, consigne1*3/2);
  myPID2.SetOutputLimit(0, consigne2*3/2);
  while((consigne1-distance1)>=error && (consigne2-distance2)>=error)
  {
    p1=myPID1.Compute();
    p2=myPID2.Compute();
    if(distance1>distance2)
    {
      p2+=5;
    }
    else if(distance2>distance1)
    p1+=5;
    analogWrite(MOTOR_PIN_SPEED1,p1);
    analogWrite(MOTOR_PIN_SPEED2,p2);
    Or-=(distance1-old_distance)*degre_per_cm;
    old_distance=distance1;
    
  }
  stop();
 
  if(Or<=-180)
    Or+=360;
  distance1=0;distance2=0; encodeur1A=0;encodeur2A=0;
}

void stop() {                                                         // arrete les moteurs
 
  
  analogWrite(MOTOR_PIN_SPEED1,0);
  analogWrite(MOTOR_PIN_SPEED2,0);
  double time=millis();
  while(millis()-time<=100);
 
}




void servo_open()                                                   // fonction d'ouverture de la pince
{
  for(int j=180;j>=0;j--)
  {
    servo.write(j);
    delay(10);
  }
}

void servo_close()                                                // fermeture de la pince
{
  for(int j=0;j<=180;j++)        
  {
    servo.write(j);
    delay(10);
  }
}


void control_moteur(double xd,double yd,double Od)   // deplace le robot vers (xd,yd), sincerement j'utilise pas l'angle Od dans ce cas
{
   // on verifie dans quelle position est le robot puis on execute le code correspondant
   if(abs(Or)<=13)     
   {
      op0(xd,yd,Od);
   }
   else if(abs(Or-90)<=13)
   {
      op1(xd,yd,Od);
   }
   else if(abs(abs(Or)-180)<=13)
   {
      op2(xd,yd,Od);
   }
   else
   {
      op3(xd,yd,Od);
   }

}


void encode1(void)                                               // fonction  interruption pour encodeur1A
{
  
  if(digitalRead(encode1_pinB)==HIGH)                            // si le moteur 1 avance
  encodeur1A++;
  else                                                           // si il  recule
  encodeur1A--;
   
   
   tour_r1=encodeur1A/Tick_per_rev1;                             // nombre de tour de la roue 1
   distance1=abs(perimetre_roue*tour_r1);                      // distance de la roue en cm*/   
}


void encode2(void)                                              // fonction  interruption pour encodeur2A
{
   if(digitalRead(encode2_pinB)==HIGH)                          // si le moteur 2 avance
  encodeur2A++;
  else                                                          // si il  recule
   encodeur2A--;
   
   tour_r2=encodeur2A/Tick_per_rev1;                            // nombre de tour de la roue 2
   distance2=  abs(perimetre_roue*tour_r2);                      // distance de la roue en cm
   
}

void op0(double xd,double yd,double Od)                         // dans le cas ou le robot est dans un angle de 0 degré
{
    if(xd>xr)
      {
        if(yd>yr)                        //dans le cas ou la destination est au dessus et a droite
        {
          moveForward_Y(yd-yr,1);        // on avance  en haut jusqu'a la hauteur de la destination
          turnRight(90);                // on tourne a droite de 90 degré
          moveForward_X(xd-xr,1);       // puis on avance vers la droite jusqu'a atteindre la destination
        }                               // et c'est de maniere analogue pour la suite
        else if(yd<yr)
        {
          turnRight(90);
          moveForward_X(xd-xr,1);
          turnRight(90);
          moveForward_Y(yr-yd,0);
        }
        else
        {
          turnRight(90);
          moveForward_X(xd-xr,1);
        }
      }
      else if(xd<xr)
      {
        if(yd>yr)
        {
          moveForward_Y(yd-yr,1);
          turnLeft(90);
          moveForward_X(xr-xd,0);
        }
        else if(yd<yr)
        {
          turnLeft(90);
          moveForward_X(xr-xd,0);
          turnLeft(90);
          moveForward_Y(yr-yd,0);
        }
        else
        {
          turnLeft(90);
          moveForward_X(xr-xd,0);
        }
      }
      else {
        if(yd>yr)
        {
          moveForward_Y(yd-yr,1);
          
        }
        else if(yd<yr)
        {
          turnRight(90);
          turnRight(90);
          moveForward_Y(yr-yd,0);
        }

      }
}
void op1(double xd,double yd,double Od)                                // cas ou le robot est dans un angle de 90
{
  if(xd>xr)
  {
    if(yd>yr)
     {
        moveForward_X(xd-xr,1);
        turnLeft(90);
        moveForward_Y(yd-yr,1);
     }
     else if(yd<yr)
     {
        moveForward_X(xd-xr,1);
        turnRight(90);
        moveForward_Y(yr-yd,0);
     }
     else {
        moveForward_X(xd-xr,1);
     }
  }
  else if(xd<xr)
  {
    if(yd>yr)
    {
      turnLeft(90);
      moveForward_Y(yd-yr,1);
      turnLeft(90);
      moveForward_X(xr-xd,0);
    }
    else if(yd<yr)
    {
      turnRight(90);
      moveForward_Y(yr-yd,0);
      turnRight(90);
      moveForward_X(xr-xd,0);

    }
    else
      {
      turnLeft(90);
      turnLeft(90);
      moveForward_X(xr-xd,0);
      }
  }
  else
  {
    if(yd>yr)
     {
        
        turnLeft(90);
        moveForward_Y(yd-yr,1);
     }
     else if(yd<yr)
     {
        
        turnRight(90);
        moveForward_Y(yr-yd,0);
     }
  }
}

void op2(double xd,double yd,double Od)                                // cas ou le robot est dans un angle de 180
{
  if(xd>xr)
  {
    if(yd>yr)
     {
        turnLeft(90);
        moveForward_X(xd-xr,1);
        turnLeft(90);
        moveForward_Y(yd-yr,1);
     }
     else if(yd<yr)
     {
        moveForward_Y(yr-yd,0);
        turnLeft(90);
        moveForward_X(xd-xr,1);
     }
     else
     {
        turnLeft(90);
        moveForward_X(xd-xr,1);
     }
  }
  else if(xd<xr)
  {
    if(yd>yr)
    {
      turnRight(90);
      moveForward_X(xr-xd,0);
      turnRight(90);
      moveForward_Y(yd-yr,1);
    }
    else if(yd<yr)
    {
      moveForward_Y(yr-yd,0);
      turnRight(90);
      moveForward_X(xr-xd,0);
    }
    else
    {
        turnRight(90);
       moveForward_X(xr-xd,0);
    }
  }
  else {
    if(yd>yr)
     {
        turnLeft(90);
        turnLeft(90);
        moveForward_Y(yd-yr,1);
     }
     else if(yd<yr)
     {
        moveForward_Y(yr-yd,0);
        
     }
  }
}
void op3(double xd,double yd,double Od)                                // cas ou le robot est dans un angle de -90 ou 270
{
  if(xd>xr)
  {
    if(yd>yr)
     {
        turnRight(90);
        moveForward_Y(yd-yr,1);
        turnRight(90);
        moveForward_X(xd-xr,1);
     }
     else if(yd<yr)
     {
        turnLeft(90);
        moveForward_X(yr-yd,0);
        turnLeft(90);
        moveForward_Y(xd-xr,1);
     }
     else
     {
       turnRight(90);
        turnRight(90);
        moveForward_X(xd-xr,1);
     }
  }
  else if(xd<xr)
  {
    if(yd>yr)
    {
      moveForward_X(xr-xd,0);
      turnRight(90);
      moveForward_Y(yd-yr,1);
    }
    else if(yd<yr)
    {
      moveForward_X(xr-xd,0);
      turnLeft(90);
      moveForward_Y(yr-yd,0); 
    }
    else
    {
      moveForward_X(xr-xd,0);
    }
  }
  else {
      if(yd>yr)
     {
        turnRight(90);
        moveForward_Y(yd-yr,1);
        
     }
     else if(yd<yr)
     {
        
        turnLeft(90);
        moveForward_Y(xd-xr,1);
     }
  }
}


