class PIDcontroller                        // Class pour creer des instances de controller PID
{
  private:
  double Kp;
  double Ki;
  double Kd;
  int sampleTime=200;
  double *Input;                     //valeur mesurée
  double *Setpoint;                  // consigne 
  double integral=0;                 // la valeur du terme integral
  double lastErr;                   // l'erreur precedente
  double *output;                  // sortie du PID
  unsigned long lastTime=millis();   //le dernier temps de calcul de PID
  byte speed=0;                       // commande de vitesse (pwm)
  byte lastspeed=0;                   // sauvegarde de la derniere vitesse calculée avec Setpwm
  double outmax,outmin;              // valeur min et max de la sortie PID  

  public:
  PIDcontroller(double *Input,double *output,double *Setpoint,double Kp,double Ki,double Kd)
  :Input(Input),output(output),Setpoint(Setpoint),Kp(Kp),Ki(Ki),Kd(Kd) { lastErr=*Setpoint-*Input; SetOutputLimit(0, 255);}

  byte Compute()
  {
      unsigned long now=millis();
      int timeChange=(now -lastTime);
      if(timeChange>=sampleTime)                    // echantillonnage
      {
        double error= *Setpoint -*Input;             // erreur 

        integral+=Ki*error;                         // valeur integral

        double dErr=error-lastErr;                  // derivée de l'erreur

        *output=Kp*error + integral + Kd*dErr;      // sortie
        if(*output<=outmin)                        // fixe la sortie a sortie min quand elle est inferieur a sortie min
        {
          *output=outmin;
        } 
        if(*output>=outmax)                      // fixe la sortie a sortie max  quand elle depasse
        {
          *output=outmax;
        }

        lastTime=now;                             
        lastErr=error;                     // sauvegarde de l'erreur
         return this->SetPWM();            //donc ici on calcul et retourne la vitesse dans la l'echantillonnage                       
      }
      return lastspeed;                   // et en dehors de l'echantillonnage ,on retourne la derniere vitesse calculer
  }

  byte SetPWM(){                      // gestion de la vitesse(pwm) en fonction de la sortie
    if(*output>=outmax*2/3)           // quand on est a  plus de 2/3 de la sortie max
    {
      if(speed+10>=160)               // la vitesse max etant de 160 
      {
        speed=160;
        
      }
      else                             // on augmente progressivement la vitesse tant qu'on atteint la vitesse max
      speed+=10;
        
    }
    else if(*output>=outmax/3)      // quand la sortie est entre 2/3 et 1/3 de la sortie max
    {                                 
                                       // on fait rien on laisse la vitesse qu'elle avait avant
    } 
    else if(*output>0) {             //quand la sortie est entre 0 et 1/3
       if(speed-40<=0)               //si la vitesse est inferieur a 40
       {
        if((*Setpoint-*Input)>=error)  //  si on a une erreur superieur a "error"
          speed=40;                  // on maintient la vitesse  a 40
        else
          speed=0;                 // sinon on s'arrete
       }
       else                        // si la vitesse est superieur a 40 
        speed-=10;                  // on decremente la vitesse de 10
    }
   
    lastspeed=speed;   // ici le lastspeed onus permet de garder une memoire de la vitesse 
    return speed;       // on retourne la vitesse
  }   
                               // methode pour gerer la vitesse en fonction de la sortie de PID

  void SetSampleTime(int NewSampleTime)            // modifier l'echantillonnage
  {
    if(NewSampleTime>0)
    {
      double ratio=(double)NewSampleTime/(double)sampleTime;
      Ki*=ratio;
      Kd/=ratio;
      sampleTime=(unsigned long )NewSampleTime;
    }
  }
  void SetOutputLimit(int min ,int max)               // les limites de sorties de PID
  {                                                  // cette fonction est appelée apres chaque changement de consigne 
    if(min>max) return;
    outmax=max;
    outmin=min;

  }
};



// PID pour les deux moteurs

PIDcontroller myPID1(&distance1,&output1,&consigne1,P,I,D);                  //PID controller pour moteur1
PIDcontroller myPID2(&distance2,&output2,&consigne2,P,I,D);                  //PID controller pour moteur2
 

//servo moteur 
Servo servo;



void setup() {
  
  Serial.begin(9600);

  // mise en place  du mapping des entrées et sorties

  pinMode(TRIG_PIN_FRONT, OUTPUT);
  pinMode(ECHO_PIN_FRONT, INPUT);

  pinMode(MOTOR_PIN_DIRECT1,OUTPUT);
  pinMode(MOTOR_PIN_DIRECT2,OUTPUT);

  pinMode(MOTOR_PIN_SPEED1,OUTPUT);
  pinMode(MOTOR_PIN_SPEED2,OUTPUT);
  
  pinMode(encode1_pinA,INPUT);
  pinMode(encode2_pinA,INPUT);
  myPID1.SetOutputLimit(0, consigne1*3/2);             // en prenant en compte les parametres P,I et D j'ai remarqué que la sortie 
  myPID2.SetOutputLimit(0, consigne2*3/2);             // maximale ne depasse pas 3/2 de la consigne 
  

  

  servo.attach(7);                                                         //attacher le pin 7 a la sortie servomoteur
  

  attachInterrupt(digitalPinToInterrupt(encode1_pinA),encode1,RISING);    // interruption sur l'encodeurA du moteur1 pour compter les ticks
  attachInterrupt(digitalPinToInterrupt(encode2_pinA),encode2,RISING);    // interruption sur l'encodeurA du moteur 2 pour compter les ticks
  

}


