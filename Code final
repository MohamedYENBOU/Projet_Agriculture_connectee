void servo_open()                                                   // fonction de deploiement de l'aile pour tourner les panneaux
{
  for(int j=280;j>=0;j--)
  {
    servo.write(j);
    delay(10);
  }
}

void servo_close()                                                // fonction de repliement
{
  for(int j=0;j<=280;j++)        
  {
    servo.write(j);
    delay(10);
  }
}


void control_moteur(position p)   // deplace le robot vers (xd,yd)
{  // on verifie dans quelle position est le robot puis on execute le code correspondant
   int obstacle=0;
   if(abs(Or)<=10)                  //  si le robot est en direction des Y positifs
   {  Or=0;
      obstacle=op0(p.x,p.y);
   }
   else if(abs(Or-90)<=13)          //  si le robot est en direction des X positifs
   {
      Or=90;
      obstacle=op1(p.x,p.y);
   }
   else if(abs(abs(Or)-180)<=13)   //  si le robot est en direction des Y negatifs
   {
      Or=180;
      obstacle=op2(p.x,p.y);
   } 
   else                            //  si le robot est en direction des X  negatifs
   {   
      Or=-90;
      obstacle=op3(p.x,p.y);
   }
   if(obstacle==1)                          // si un obstacle a été rencontrer et contourné
   { 
        control_moteur(p);                  // on continue vers la destination
   }
}


