#include <Arduino_FreeRTOS.h>
#include <task.h>

// Define pin numbers for ultrasonic sensors
#define TRIG_PIN_FRONT A3
#define ECHO_PIN_FRONT A2
#define MOTOR_PIN_DIRECT1  12
#define MOTOR_PIN_FREIN1   9
#define MOTOR_PIN_DIRECT2  13
#define MOTOR_PIN_FREIN2   8
#define MOTOR_PIN_SPEED1  3
#define MOTOR_PIN_SPEED2  11
#define encode_pin1        2
#define encode_pin2        3
// Define distances for obstacle detection
#define MIN_DISTANCE_FRONT 20
#define MIN_DISTANCE_SIDE 15
// PID PARAMETERS
float P=1.3;//1.02
float I=0.005;
float D=0.024;
int encodeur=0;

// Function prototypes
void obstacleDetectionTask(void* pvParameters);
void motorControlTask(void* pvParameters);
void moveForward();
void moveBackward();
void turnLeft();
void turnRight();
void stop();
float PID_Corrector(int target,float *LastError,float ederivative, float *eIntegral,float *LastTime);

void setup() {
  Serial.begin(9600);

  pinMode(TRIG_PIN_FRONT, OUTPUT);
  pinMode(ECHO_PIN_FRONT, INPUT);
  pinMode(MOTOR_PIN_DIRECT1,OUTPUT);
  pinMode(MOTOR_PIN_DIRECT2,OUTPUT);
  pinMode(MOTOR_PIN_SPEED1,OUTPUT);
  pinMode(MOTOR_PIN_SPEED2,OUTPUT);
  pinMode(MOTOR_PIN_FREIN1,OUTPUT);
  pinMode(MOTOR_PIN_FREIN2,OUTPUT);
  pinMode(encode_pin1,INPUT);
  pinMode(encode_pin2,INPUT);

  xTaskCreate(obstacleDetectionTask, "ObstacleDetection", 1000, NULL, 1, NULL);
  xTaskCreate(motorControlTask, "MotorControl", 1000, NULL, 2, NULL);
  attachInterrupt(digitalPinToInterrupt(encode_pin1),encode,RISING);

  vTaskStartScheduler();
}

void loop() {
  
  //is should never be reached
}

