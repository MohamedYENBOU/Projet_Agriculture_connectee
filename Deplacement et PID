  while (1) {
    long duration, distance;

    // Front sensor
    digitalWrite(TRIG_PIN_FRONT, LOW);
    delayMicroseconds(2);
    digitalWrite(TRIG_PIN_FRONT, HIGH);
    delayMicroseconds(10);
    digitalWrite(TRIG_PIN_FRONT, LOW);
    duration = pulseIn(ECHO_PIN_FRONT, HIGH);
    distance = duration * 0.034 / 2;

    if (distance < MIN_DISTANCE_FRONT) {
      // Obstacle detected in front
      // Implement avoidance strategy here
    }

    vTaskDelay(100); // Delay for sensor reading
  }
}

void motorControlTask(void* pvParameters) {
  (void) pvParameters;
   float LastError=0,ederivative, eIntegral=0, LastTime=0;
   digitalWrite(MOTOR_PIN_DIRECT2,LOW);
   analogWrite(MOTOR_PIN_SPEED2,0);
  while (1) {

    // Implement motor control logic here
    // Adjust motor speeds and directions based on obstacle detection
    
  
   float u;
    //vTaskDelay(2000/portTICK_PERIOD_MS);
    u=PID_Corrector(1000, &LastError,ederivative, &eIntegral, &LastTime);
    
    if(abs(u)>255)
      analogWrite(MOTOR_PIN_SPEED2,255);
    else
      analogWrite(MOTOR_PIN_SPEED2,abs(u));

    
    // vTaskDelay(100);
  }
}

void moveForward() {
  // Replace these with the actual pins on your shield
  digitalWrite(MOTOR_PIN_DIRECT1,HIGH);
  analogWrite(MOTOR_PIN_SPEED1,100);
  digitalWrite(MOTOR_PIN_DIRECT2,LOW);
  analogWrite(MOTOR_PIN_SPEED2,100);
  digitalWrite(MOTOR_PIN_FREIN1,LOW);
  digitalWrite(MOTOR_PIN_FREIN2,LOW);
}

void moveBackward() {
  // Replace these with the actual pins on your shield
  digitalWrite(MOTOR_PIN_DIRECT1,LOW);
  analogWrite(MOTOR_PIN_SPEED1,100);
  digitalWrite(MOTOR_PIN_DIRECT2,HIGH);
  analogWrite(MOTOR_PIN_SPEED2,100);
  digitalWrite(MOTOR_PIN_FREIN1,LOW);
  digitalWrite(MOTOR_PIN_FREIN2,LOW);
}

void turnLeft() {
  // Replace these with the actual pins on your shield
  digitalWrite(MOTOR_PIN_DIRECT1,HIGH);
  analogWrite(MOTOR_PIN_SPEED1,90);
  digitalWrite(MOTOR_PIN_DIRECT1,HIGH);
  analogWrite(MOTOR_PIN_SPEED2,90);
  digitalWrite(MOTOR_PIN_FREIN1,LOW);
  digitalWrite(MOTOR_PIN_FREIN2,LOW);
}

void turnRight() {
  // Replace these with the actual pins on your shield
  digitalWrite(MOTOR_PIN_DIRECT1,LOW);
  analogWrite(MOTOR_PIN_SPEED1,90);
  digitalWrite(MOTOR_PIN_DIRECT1,LOW);
  analogWrite(MOTOR_PIN_SPEED2,90);
  digitalWrite(MOTOR_PIN_FREIN1,LOW);
  digitalWrite(MOTOR_PIN_FREIN2,LOW);
}

void stop() {
  // Replace these with the actual pins on your shield
  digitalWrite(MOTOR_PIN_FREIN1,HIGH);
  digitalWrite(MOTOR_PIN_FREIN2,HIGH);
  analogWrite(MOTOR_PIN_SPEED1,0);
  analogWrite(MOTOR_PIN_SPEED2,0);
}
